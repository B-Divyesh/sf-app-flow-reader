{
  "name": "app-flow-reader",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first browser extension for following saved routes through dense apps.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:site": "vite --config vite.config.ts",
    "build": "npm run build:site",
    "build:site": "vite build --config vite.config.ts && npm run package:extension",
    "build:extension": "wxt build",
    "package:extension": "wxt build && wxt zip && node scripts/package-extension.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:claims": "playwright test --grep @claim:",
    "test:a11y": "playwright test --grep @a11y",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "check:copy": "node scripts/check-copy-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "playwright-core": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wxt": "0.21.4"
  }
}
